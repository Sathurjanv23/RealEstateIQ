# RealEstateIQ — Backend Environment Variables

# MongoDB
MONGO_URI=mongodb://localhost:27017/realestate_iq

# JWT
JWT_SECRET=change-this-to-a-long-random-secret-string-in-production
JWT_EXPIRES_IN=7d

# ML Service
ML_SERVICE_URL=http://localhost:8000

# Server
PORT=5000
NODE_ENV=development

# CORS — comma-separated allowed origins
CORS_ORIGIN=http://localhost:3000

# Logging
LOG_LEVEL=info

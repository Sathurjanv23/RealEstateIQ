# RealEstateIQ — Frontend Environment Variables

# Backend API base URL
# Local development:
NEXT_PUBLIC_API_URL=http://localhost:5000
# Production (set this in Vercel → Project Settings → Environment Variables):
# NEXT_PUBLIC_API_URL=https://realestate-iq-backend.onrender.com

# Google OAuth 2.0 Client ID (matches GOOGLE_CLIENT_ID in backend)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

